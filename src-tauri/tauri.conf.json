{
  "productName": "Swritor",
  "version": "0.2.8",
  "identifier": "com.swritor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBNEU3QTJGRUQ5MDRFQkYKUldTL1RwRHRMM3BPYWdHZ0NHR1I5MDdWOWQzMFM4NFowRlNQSlQ2aFduUllvMEYxN2hOeWJSVTgK",
      "endpoints": [
        "https://github.com/Suzichen/swritor/releases/latest/download/latest.json"
      ]
    }
  }
}
